DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AGENT_MODEL=deepseek-chat

WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your_tavily_api_key
TAVILY_SEARCH_URL=https://api.tavily.com/search
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=12

VOLCENGINE_TTS_APP_ID=your_volcengine_app_id
VOLCENGINE_TTS_ACCESS_TOKEN=your_volcengine_access_token
VOLCENGINE_TTS_CLUSTER=volcano_tts
VOLCENGINE_TTS_VOICE_TYPE=your_volcengine_voice_type
VOLCENGINE_TTS_URL=https://openspeech.bytedance.com/api/v1/tts
VOLCENGINE_TTS_ENCODING=mp3
VOLCENGINE_TTS_SPEED_RATIO=1.0
VOLCENGINE_TTS_VOLUME_RATIO=1.0
VOLCENGINE_TTS_PITCH_RATIO=1.0

VOLCENGINE_ASR_APP_ID=your_volcengine_app_id
VOLCENGINE_ASR_ACCESS_TOKEN=your_volcengine_access_token
VOLCENGINE_ASR_RESOURCE_ID=volc.bigasr.sauc.duration
VOLCENGINE_ASR_CLUSTER=volc.bigasr.sauc.duration
VOLCENGINE_ASR_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel
VOLCENGINE_ASR_WORKFLOW=audio_in,resample,partition,vad,fe,decode
VOLCENGINE_ASR_FORMAT=pcm
VOLCENGINE_ASR_CODEC=raw

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=culture_video_agent

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
MUSIC_ROOT=/data/culture-agent/media/audio
VIDEO_ROOT=/data/culture-agent/media/video

CALLIGRAPHY_DATASET_DIR=/data/culture-agent/calligraphy_fonts
CALLIGRAPHY_OUTPUT_DIR=/data/culture-agent/generated/calligraphy

KNOWLEDGE_BASE_DOCS_DIR=/data/culture-agent/knowledge_base/docs
KNOWLEDGE_BASE_CHROMA_DIR=/data/culture-agent/knowledge_base/chroma
KNOWLEDGE_BASE_COLLECTION=culture_knowledge
KNOWLEDGE_BASE_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
KNOWLEDGE_BASE_TOP_K=4
KNOWLEDGE_BASE_CHUNK_SIZE=800
KNOWLEDGE_BASE_CHUNK_OVERLAP=120
